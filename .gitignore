# Data layers are never committed (the raw dataset alone is ~107 MB). Git cannot
# un-ignore a file inside a directory matched by a bare "data/" pattern, so this
# un-ignores one directory at a time down to the one file that must stay tracked.
data/*
!data/raw/
data/raw/*
!data/raw/MANIFEST.json

# Raw dataset format; also guards against a stray .pkl outside data/.
*.pkl

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Secrets — .env.example is committed, actual .env files never are.
.env
.env.*
!.env.example
!frontend/.env.example

# Node / frontend build output (frontend/.gitignore also covers these locally)
node_modules/
frontend/dist/
frontend/build/

# Logs
*.log

# macOS
.DS_Store

# Editor/IDE artifacts (frontend/.gitignore already scopes .vscode/.idea there;
# .vscode/settings.json at the repo root is intentionally tracked for shared
# Python interpreter config, so it is not ignored here)
.idea/

# Tool-specific local working directories
.claude/
.impeccable/
