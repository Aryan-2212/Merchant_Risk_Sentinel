# Merchant Risk Sentinel — environment template.
# Copy to .env and fill in. Never commit .env (Dev Plan §33.10).
#
# Phase 1 requires no secrets: the Handbook dataset is fetched from public URLs.
# The variables below are declared for later phases and are all optional today.

# Override the data root if you keep the dataset outside the repository.
# MRS_DATA_DIR=/absolute/path/to/data

# Phase 8 (backend, per Development Plan §19/§27 "Phase 7 -- Backend"; this repo's
# checkpoint numbering has diverged from the Plan's -- see docs/BACKEND_REPORT.md).
# SQLAlchemy + psycopg (v3) connection string. Local dev default (peer/trust auth, no
# password) matches the `merchant_risk_sentinel` database created for this project;
# mrs.db.engine falls back to this exact value when the variable is unset.
# MRS_DATABASE_URL=postgresql+psycopg://localhost/merchant_risk_sentinel

# Tests (tests/conftest.py db_engine fixture) use a SEPARATE database so the test
# suite's create_all/drop_all never touches the real one above. Default assumes
# `createdb merchant_risk_sentinel_test` was run once; override if needed.
# MRS_TEST_DATABASE_URL=postgresql+psycopg://localhost/merchant_risk_sentinel_test

# Phase 8 Step 6 (AI Risk Analyst). Required only to get live LLM explanations from
# GET /transactions/{id}/analyst; when unset (or invalid/unreachable), that endpoint
# still returns 200 with a deterministic fallback explanation (mrs.analyst.client).
# Get a key at https://aistudio.google.com/apikey. GOOGLE_API_KEY also works and takes
# precedence if both are set -- only one is needed.
# GEMINI_API_KEY=
